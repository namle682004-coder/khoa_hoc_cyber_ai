QDRANT_IMAGE=qdrant/qdrant:v1.15.4
QDRANT_CONTAINER_NAME=chapter5-qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_BASE_URL=http://localhost:6333
QDRANT_HEALTH_URL=http://localhost:6333/healthz
QDRANT_STARTUP_TIMEOUT=60
QDRANT_STARTUP_POLL_INTERVAL=2

# Optional API key. Leave empty for local development only.
QDRANT_API_KEY=

# Default collection profile for RAG examples
DEFAULT_COLLECTION=rag_documents
VECTOR_SIZE=384
DISTANCE=Cosine
