MODEL_NAME=deepseek-ai/DeepSeek-Coder-V2-Lite-Base
MODEL_DTYPE=float16
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.9
HF_TOKEN=

# Shared storage outside this project.
# Default behavior when these are empty:
#   HF_HOME=$HOME/.cache/huggingface
#   HF_CACHE_DIR=$HF_HOME
#   CHECKPOINT_ROOT=$HF_HOME/checkpoints
HF_HOME=
HF_CACHE_DIR=
CHECKPOINT_ROOT=

VLLM_IMAGE_NAME=chapter4-vllm
VLLM_CONTAINER_NAME=chapter4-vllm
VLLM_PORT=8000
VLLM_BASE_URL=http://localhost:8000/v1

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8100
FASTAPI_DEMO_USERNAME=demo
FASTAPI_DEMO_PASSWORD=demo123
FASTAPI_DEMO_TOKEN=demo-secret-token
FASTAPI_DEFAULT_SYSTEM_PROMPT="You are a concise coding assistant."

GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
